PORT=3000
HOST=0.0.0.0

OPENAI_API_KEY=your-openai-api-key
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

API_KEY=change-this-internal-secret

DEFAULT_LANGUAGE=id

TEMP_DIR=./temp

MAX_UPLOAD_MB=500
MAX_CHUNK_MB=24

CHUNK_SECONDS=600
FFMPEG_AUDIO_BITRATE=64k
FFMPEG_AUDIO_CHANNELS=1
FFMPEG_AUDIO_SAMPLE_RATE=16000

REQUEST_TIMEOUT_MS=1800000
OPENAI_CHUNK_RETRIES=3
OPENAI_RETRY_BASE_MS=1000

GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
